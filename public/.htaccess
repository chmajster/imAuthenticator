Options -Indexes
RewriteEngine On

RewriteRule ^oauth/token/?$ token.php [QSA,L]
RewriteRule ^\.well-known/openid-configuration/?$ discovery.php [QSA,L]
RewriteRule ^login/?$ login.php [QSA,L]
RewriteRule ^applications/catalog/?$ application-catalog.php [QSA,L]
RewriteRule ^access-requests/?$ application-catalog.php [QSA,L]
RewriteRule ^account/passkeys/?$ passkeys.php [QSA,L]
RewriteRule ^account/devices/?$ account-devices.php [QSA,L]
RewriteRule ^account/global-logout/?$ global-logout.php [QSA,L]
RewriteRule ^webauthn/register/options/?$ passkey-options.php [QSA,L]
RewriteRule ^scim/v2/([0-9]+)/(ServiceProviderConfig|Users|Groups)/?$ scim.php?connector=$1&resource=$2 [QSA,L]
RewriteRule ^scim/v2/([0-9]+)/(Users|Groups)/([^/]+)/?$ scim.php?connector=$1&resource=$2&resource_id=$3 [QSA,L]
RewriteRule ^admin/access-requests/?$ admin-access-requests.php [QSA,L]
RewriteRule ^admin/access-reviews/?$ admin-access-reviews.php [QSA,L]
RewriteRule ^admin/scim/?$ admin-scim.php [QSA,L]
RewriteRule ^admin/security/?$ security-dashboard.php [QSA,L]
RewriteRule ^admin/audit/export/?$ audit-export.php [QSA,L]
RewriteRule ^admin/identity-providers/?$ admin-identity-providers.php [QSA,L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^admin/applications/?$ applications-list.php [QSA,L]
RewriteRule ^admin/applications/new/?$ application-new.php [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/edit/?$ application-edit.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/users/?$ application-users.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/access-policy/?$ application-access-policy.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/rotate-secret/?$ client-secret-rotate.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/config-with-secret\.json$ application-config-secret.php?id=$1 [QSA,L]
RewriteRule ^admin/users/([0-9]+)/applications/?$ user-applications.php?id=$1 [QSA,L]
RewriteCond %{QUERY_STRING} (^|&)created=1(&|$)
RewriteRule ^admin/applications/([0-9]+)/?$ application-created.php?id=$1 [QSA,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^admin/applications/([0-9]+)/?$ application-detail.php?id=$1 [QSA,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
