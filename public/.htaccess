Options -Indexes
RewriteEngine On

RewriteRule ^oauth/authorize/?$ authorize.php [QSA,L]
RewriteRule ^oauth/token/?$ token.php [QSA,L]
RewriteRule ^oauth/device_authorization/?$ oauth-device-authorization.php [QSA,L]
RewriteRule ^oauth/par/?$ oauth-par.php [QSA,L]
RewriteRule ^oauth/consent/?$ oauth-consent.php [QSA,L]
RewriteRule ^connect/register/?$ dynamic-register.php [QSA,L]
RewriteRule ^activate/?$ activate.php [QSA,L]
RewriteRule ^auth/external/start/?$ auth-external-start.php [QSA,L]
RewriteRule ^auth/external/callback/?$ auth-external-callback.php [QSA,L]
RewriteRule ^saml/metadata/?$ saml-metadata.php [QSA,L]
RewriteRule ^saml/sso/?$ saml-sso.php [QSA,L]
RewriteRule ^saml/sso/resume/?$ saml-sso-resume.php [QSA,L]
RewriteRule ^saml/slo/?$ saml-slo.php [QSA,L]
RewriteRule ^\.well-known/openid-configuration/?$ discovery.php [QSA,L]
RewriteRule ^\.well-known/jwks\.json/?$ jwks.php [QSA,L]
RewriteRule ^api/v1/events/?$ api-events.php [QSA,L]
RewriteRule ^login/?$ login.php [QSA,L]
RewriteRule ^mfa/challenge/?$ mfa-challenge.php [QSA,L]
RewriteRule ^magic-login/request/?$ magic-login-request.php [QSA,L]
RewriteRule ^magic-login/consume/?$ magic-login-consume.php [QSA,L]
RewriteRule ^dashboard/?$ dashboard.php [QSA,L]
RewriteRule ^applications/catalog/?$ application-catalog.php [QSA,L]
RewriteRule ^access-requests/?$ application-catalog.php [QSA,L]
RewriteRule ^account/mfa/?$ account-mfa.php [QSA,L]
RewriteRule ^account/passkeys/?$ passkeys.php [QSA,L]
RewriteRule ^account/emails/?$ account-emails.php [QSA,L]
RewriteRule ^account/emails/verify/?$ account-email-verify.php [QSA,L]
RewriteRule ^account/consents/?$ account-consents.php [QSA,L]
RewriteRule ^account/required-actions/?$ required-actions.php [QSA,L]
RewriteRule ^account/app-preferences/?$ app-preferences.php [QSA,L]
RewriteRule ^account/devices/?$ account-devices.php [QSA,L]
RewriteRule ^account/global-logout/?$ global-logout.php [QSA,L]
RewriteRule ^impersonation/end/?$ impersonation-end.php [QSA,L]
RewriteRule ^webauthn/register/options/?$ passkey-options.php [QSA,L]
RewriteRule ^webauthn/register/complete/?$ passkey-register-complete.php [QSA,L]
RewriteRule ^webauthn/login/options/?$ passkey-login-options.php [QSA,L]
RewriteRule ^webauthn/login/complete/?$ passkey-login-complete.php [QSA,L]
RewriteRule ^scim/v2/([0-9]+)/(ServiceProviderConfig|Users|Groups)/?$ scim.php?connector=$1&resource=$2 [QSA,L]
RewriteRule ^scim/v2/([0-9]+)/(Users|Groups)/([^/]+)/?$ scim.php?connector=$1&resource=$2&resource_id=$3 [QSA,L]
RewriteRule ^admin/access-requests/?$ admin-access-requests.php [QSA,L]
RewriteRule ^admin/access-reviews/?$ admin-access-reviews.php [QSA,L]
RewriteRule ^admin/scim/?$ admin-scim.php [QSA,L]
RewriteRule ^admin/security/?$ security-dashboard.php [QSA,L]
RewriteRule ^admin/system/?$ admin-system.php [QSA,L]
RewriteRule ^admin/legal/?$ admin-legal.php [QSA,L]
RewriteRule ^admin/housekeeping/?$ admin-housekeeping.php [QSA,L]
RewriteRule ^admin/impersonation/?$ admin-impersonation.php [QSA,L]
RewriteRule ^admin/integration-tools/?$ admin-integration-tools.php [QSA,L]
RewriteRule ^admin/deliveries/?$ admin-deliveries.php [QSA,L]
RewriteRule ^admin/users/import/?$ admin-user-import.php [QSA,L]
RewriteRule ^admin/users/merge/?$ admin-user-merge.php [QSA,L]
RewriteRule ^admin/audit/export/?$ audit-export.php [QSA,L]
RewriteRule ^admin/identity-providers/?$ admin-identity-providers.php [QSA,L]
RewriteRule ^admin/identity-providers/([0-9]+)/directory/?$ admin-directory.php?id=$1 [QSA,L]
RewriteRule ^admin/dynamic-registration/?$ admin-dynamic-registration.php [QSA,L]
RewriteRule ^admin/signing-keys/?$ admin-signing-keys.php [QSA,L]
RewriteRule ^admin/service-accounts/?$ admin-service-accounts.php [QSA,L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^admin/applications/?$ applications-list.php [QSA,L]
RewriteRule ^admin/applications/new/?$ application-new.php [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/edit/?$ application-edit.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/users/?$ application-users.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/access-policy/?$ application-access-policy.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/rotate-secret/?$ client-secret-rotate.php?id=$1 [QSA,L]
RewriteRule ^admin/applications/([0-9]+)/config-with-secret\.json$ application-config-secret.php?id=$1 [QSA,L]
RewriteRule ^admin/users/([0-9]+)/applications/?$ user-applications.php?id=$1 [QSA,L]
RewriteCond %{QUERY_STRING} (^|&)created=1(&|$)
RewriteRule ^admin/applications/([0-9]+)/?$ application-created.php?id=$1 [QSA,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^admin/applications/([0-9]+)/?$ application-detail.php?id=$1 [QSA,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
